# VITE_SUPABASE_URL: Public Project URL for the SuweldoTools Supabase project.
# Example format: https://<your-project-ref>.supabase.co
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public publishable/anon key for the Supabase client.
# Never place a service_role or secret key in a VITE_ variable.
VITE_SUPABASE_ANON_KEY="your-public-anon-or-publishable-key"

# VITE_SUPABASE_BLOG_IMAGES_BUCKET: Optional public Supabase Storage bucket name for blog featured image uploads.
# Defaults to "blog-images" when omitted.
VITE_SUPABASE_BLOG_IMAGES_BUCKET="blog-images"
